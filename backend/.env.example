# ==========================================
# Audio Notes Platform — Backend Configuration
# ==========================================

# General Application Settings
PROJECT_NAME="Audio Notes Platform API"
VERSION="1.0.0"
DEBUG=false
API_V1_STR="/api/v1"

# CORS Configuration (Comma-separated or JSON list of frontend origins)
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000", "https://your-domain.com"]

# Database Configuration
# Production PostgreSQL (e.g. Neon, Supabase, Render, or Docker PostgreSQL on EC2)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/audio_notes
DB_ECHO=false

# Storage Configuration
# Set to "s3" for AWS S3 production storage, or "local" for local filesystem development
STORAGE_BACKEND=s3
LOCAL_STORAGE_DIR="./uploads"

# AWS S3 Settings (Used when STORAGE_BACKEND=s3)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=your-audio-notes-bucket-name
# Optional: AWS_S3_ENDPOINT_URL=https://... (if using MinIO or custom S3 endpoint)
S3_PRESIGNED_EXPIRY_SECONDS=3600

# Gnani Voice AI STT API Configuration
# Sign up at gnani.ai to receive API Key.
# If omitted, system runs in Demo Simulation Mode for local offline testing.
GNANI_API_KEY=your_gnani_api_key_here
GNANI_BASE_URL="https://api.vachana.ai"
GNANI_REST_ENDPOINT="https://api.vachana.ai/stt/v3"
GNANI_BATCH_JOBS_ENDPOINT="https://api.vachana.ai/stt/v3/batch/jobs"
GNANI_DEFAULT_LANGUAGE="en-IN"
GNANI_MAX_REST_AUDIO_SECONDS=25

# LLM Summarization Provider
# Options: "gemini" | "groq" | "openai"
LLM_PROVIDER=gemini

# Provider API Keys
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Constraints (see backend/app/config.py for rationale)
MAX_UPLOAD_SIZE_MB=500

# Background job queue (durable). Leave empty for in-process BackgroundTasks local dev.
REDIS_URL=redis://redis:6379/0
JOB_QUEUE_NAME=audio_notes:jobs
